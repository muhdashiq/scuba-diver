# Base path the app is served from. The GitHub Actions workflow sets this to
# "/<repository-name>/" automatically. Leave unset for local development.
# VITE_BASE_PATH=/scuba-diver/

# Optional: override the public API endpoints (all are free and key-less by default).
# VITE_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# VITE_OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# VITE_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Future: Supabase persistence (not required; LocalStorage is used when unset).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
